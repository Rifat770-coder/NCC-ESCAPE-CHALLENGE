# =====================================================
# NCC ESCAPE CHALLENGE — Environment Variables
# =====================================================
# Copy this file to `.env.local` for local development.
# In Vercel, set the same variables in Project Settings → Environment Variables.
# NEVER commit real secrets to git.
#
# NOTE: NEXT_PUBLIC_APPWRITE_ENDPOINT and NEXT_PUBLIC_APPWRITE_PROJECT_ID
# are baked into lib/appwrite/config.ts as defaults so the web SDK boots
# without configuration. Override here only if you fork to a new project.

# ---- Public Appwrite (exposed to the browser) ----
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6ac3e7c0001469e247da

# ---- Server-only Appwrite credentials (NEVER expose) ----
APPWRITE_API_KEY=your_server_api_key_here
APPWRITE_DATABASE_ID=your_database_id_here

# ---- Collection IDs (created automatically by scripts/setup-collections.ts) ----
APPWRITE_COLLECTION_PARTICIPANTS=participants
APPWRITE_COLLECTION_ATTEMPTS=gameAttempts
APPWRITE_COLLECTION_SETTINGS=gameSettings

# ---- Admin Panel ----
# Comma-separated list of admin passwords (hashed plain shared passwords).
# The panel compares the entered password against these values.
ADMIN_PASSWORDS=admin123

# ---- Optional: override base URL for share links ----
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- Optional server-only Upstash Redis (HTTPS REST, NOT redis://) ----
# Leave blank to run without Redis. Never use NEXT_PUBLIC_ for these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace may inject these instead; use one complete pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Set a distinct prefix when multiple apps share one Redis database.
REDIS_KEY_PREFIX=ncc-escape
